  "components": [
    {
      "name": "标的池导航",
      "kind": "nav",
      "refersTo": "pool-tab",
      "description": "冷灰组底上的按钮与钴蓝选中态。",
      "html": "<div class=\"ds-pool\" role=\"tablist\" aria-label=\"标的池\"><button class=\"ds-tab\" role=\"tab\" aria-selected=\"true\">全部</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">涨停</button><button class=\"ds-tab\" role=\"tab\" aria-selected=\"false\">连板</button></div>",
      "css": ".ds-pool{display:inline-flex;gap:3px;padding:3px;background:var(--paper,#f3f5f9);border-radius:6px;font-family:var(--font-body,\"Segoe UI\",sans-serif)}.ds-tab{border:0;background:transparent;color:var(--muted,#617188);border-radius:4px;padding:6px 10px;font:400 11px/1.4 var(--font-body,\"Segoe UI\",sans-serif);cursor:pointer;transition:color 160ms,background 160ms}.ds-tab:hover{background:var(--paper-3,#dce4f0);color:var(--ink,#17263c)}.ds-tab[aria-selected=\"true\"]{background:var(--accent,#245bd7);color:var(--accent-ink,#fff);font-weight:600}.ds-tab:focus-visible{outline:2px solid var(--accent,#245bd7);outline-offset:3px}@media(prefers-reduced-motion:reduce){.ds-tab{transition:none}}"
    },
    {
      "name": "股票搜索",
      "kind": "input",
      "refersTo": "search-field",
      "description": "细边界输入，钴蓝边界与浅蓝外轮廓提示焦点。",
      "html": "<label class=\"ds-search\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\"/><path d=\"M10.5 10.5L14 14\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg><input type=\"search\" aria-label=\"搜索股票代码或名称\" placeholder=\"搜索股票代码或名称\"></label>",
      "css": ".ds-search{display:flex;align-items:center;gap:9px;width:228px;min-height:36px;padding:7px 11px;border:1px solid var(--rule,#e1e7ef);background:var(--paper,#f3f5f9);border-radius:7px;color:var(--muted,#617188)}.ds-search:focus-within{border-color:var(--accent,#245bd7);outline:2px solid var(--accent-soft,#eaf0ff)}.ds-search input{min-width:0;width:100%;border:0;background:transparent;outline:none;color:var(--ink,#17263c);font:400 12px/1.55 var(--font-body,\"Segoe UI\",sans-serif);caret-color:var(--accent,#245bd7)}.ds-search input::placeholder{color:var(--muted,#617188)}"
    },
    {
      "name": "样本标记",
      "kind": "chip",
      "refersTo": "snapshot-tag",
      "description": "顶部数据性质说明，属于信息标签。",
      "html": "<span class=\"ds-snapshot\">样本复盘</span>",
      "css": ".ds-snapshot{display:inline-block;padding:3px 7px;border-radius:4px;color:var(--accent-2,#1648b8);background:var(--accent-soft,#eaf0ff);font:400 11px/1.55 var(--font-body,\"Segoe UI\",sans-serif)}"
    },
    {
      "name": "详情与列表弹窗",
      "kind": "dialog",
      "refersTo": "panel",
      "description": "按需打开的原生dialog；12px圆角、明确关闭入口、正文内部滚动，不占主云图常驻空间。片段仅展示静态外观。",
      "html": "<section class=\"ds-panel\" aria-label=\"详情弹窗外观示例\"><header class=\"ds-panel-head\"><strong>个股详情</strong><button>关闭</button></header><div class=\"ds-panel-body\"><strong>贵州茅台</strong><p>600519 · 白酒</p><div>详情或列表按需展示</div></div></section>",
      "css": ".ds-panel{width:480px;max-width:100%;border:0;border-radius:12px;background:var(--sheet,#fff);color:var(--ink-2,#34445b);overflow:hidden;box-shadow:0 16px 48px rgba(23,38,60,.2);font:400 12px/1.55 var(--font-body,\"Segoe UI\",sans-serif)}.ds-panel-head{display:flex;align-items:center;justify-content:space-between;min-height:44px;padding:12px 16px;border-bottom:1px solid var(--rule,#e1e7ef)}.ds-panel-head strong{font-size:14px;font-weight:600;color:var(--ink,#17263c)}.ds-panel-head button{border:0;background:transparent;color:var(--accent-2,#1648b8);font-size:11px}.ds-panel-body{padding:16px;line-height:1.55;overflow-y:auto}.ds-panel-body>strong{font-size:18px;font-weight:650;color:var(--ink,#17263c)}.ds-panel-body p{color:var(--muted,#617188);font-size:11px}"
    },
    {
      "name": "返回池列表",
      "kind": "button",
      "refersTo": "button-back",
      "description": "详情中的次级返回动作。",
      "html": "<button class=\"ds-back\">← 返回涨停列表</button>",
      "css": ".ds-back{padding:5px 9px;background:var(--paper,#f3f5f9);color:var(--accent-2,#1648b8);border:0;border-radius:4px;font:400 11px/1.55 var(--font-body,\"Segoe UI\",sans-serif);cursor:pointer}.ds-back:hover{background:var(--accent-soft,#eaf0ff)}.ds-back:focus-visible{outline:2px solid var(--accent,#245bd7);outline-offset:3px}"
    },
    {
      "name": "股票列表行",
      "kind": "button",
      "refersTo": "stock-list-item",
      "description": "行间细线、名称与辅助信息；可见焦点配合列表操作。",
      "html": "<button class=\"ds-stock-row\"><span><strong>贵州茅台</strong><small>600519 · 白酒</small></span><span class=\"ds-stock-code\">600519</span></button>",
      "css": ".ds-stock-row{display:flex;align-items:center;justify-content:space-between;gap:8px;width:280px;max-width:100%;padding:10px 0;border:0;border-bottom:1px solid var(--rule,#e1e7ef);background:transparent;text-align:left;color:var(--ink-2,#34445b);font:400 12px/1.55 var(--font-body,\"Segoe UI\",sans-serif);cursor:pointer}.ds-stock-row strong{display:block;color:var(--ink,#17263c);font-size:12px;font-weight:600}.ds-stock-row small{display:block;margin-top:2px;color:var(--muted,#617188);font-size:11px}.ds-stock-code{font:400 11px var(--font-outlier,Consolas,monospace);color:var(--muted,#617188)}.ds-stock-row:hover{background:var(--paper,#f3f5f9)}.ds-stock-row:focus-visible{outline:2px solid var(--accent,#245bd7);outline-offset:3px}"
    },
    {
      "name": "市场概览当前范围",
      "kind": "custom",
      "refersTo": "market-summary-active",
      "description": "静态概览的浅蓝范围标记，不模拟市场切换按钮。",
      "html": "<div class=\"ds-market\"><span>沪深A股</span><b>—</b></div>",
      "css": ".ds-market{display:inline-grid;gap:2px;position:relative;padding:10px 18px;min-width:108px;background:var(--accent-soft,#eaf0ff);font:400 11px/1.55 var(--font-body,\"Segoe UI\",sans-serif);color:var(--muted,#617188)}.ds-market::after{content:\"\";position:absolute;bottom:0;left:18px;right:18px;height:2px;background:var(--accent,#245bd7)}.ds-market b{font:600 16px/1.55 var(--font-outlier,Consolas,monospace);font-variant-numeric:tabular-nums;color:var(--ink,#17263c)}"
    },
    {
      "name": "行业与列表控件",
      "kind": "custom",
      "refersTo": "map-control",
      "description": "行业下拉只聚焦云图；查看列表按需打开弹窗。示例不执行交互。",
      "html": "<div class=\"ds-map-tools\"><label>行业 <select aria-label=\"聚焦行业\"><option>全部行业</option><option>电子</option></select></label><button aria-haspopup=\"dialog\">查看列表</button></div>",
      "css": ".ds-map-tools{display:flex;flex-wrap:wrap;align-items:center;gap:10px;font:400 11px/1.55 var(--font-body,\"Segoe UI\",sans-serif);color:var(--muted,#617188)}.ds-map-tools select{padding:4px 5px;border:1px solid var(--rule,#e1e7ef);border-radius:4px;background:var(--sheet,#fff);font-size:12px;color:var(--ink,#17263c)}.ds-map-tools button{padding:5px 8px;border:1px solid var(--rule,#e1e7ef);border-radius:4px;background:var(--sheet,#fff);color:var(--ink-2,#34445b);font:inherit}"
    },
    {
      "name": "炸板次数徽标",
      "kind": "chip",
      "refersTo": "risk-badge",
      "description": "详情中的浅红风险说明，不构成新的树图行情色。",
      "html": "<span class=\"ds-risk\">炸板 1 次</span>",
      "css": ".ds-risk{display:inline-block;padding:2px 6px;margin:0 4px 5px 0;background:var(--risk-soft,#fff0f1);color:var(--up-strong,#c52d3c);font:400 11px/1.55 var(--font-body,\"Segoe UI\",sans-serif);border-radius:4px}"
    }
  ],
  "narrative": {
    "northStar": "先看清市场，再进入细节",
    "overview": "以大盘云图实际浅色页面为用户指定参考，把主要阅读面积交给市场本身。白色工作面、冷灰底、深蓝灰文字和钴蓝界面状态构成产品框架；行情保留用户确定的红、绿、黑三色。主图由真实市值、行业层级和正常比例的中文标签建立识别路径。\n\n当前文档记录 1.2.1 已实现的设计。页面采用本机无衬线字体与等宽关键数字，细线划分功能区域，较小圆角收束全宽主云图；个股详情与列表按需弹出。参考站的连续色阶、品牌和业务代码没有搬入产品；样本日期与静态说明保持可见。",
    "keyCharacteristics": [
      "主云图优先；一级行业、二级行业和个股构成三级结构。",
      "名称先测量，按空间显示完整名、可读前缀或省略，不压缩汉字字宽。",
      "行业聚焦与明确返回支持逐级查看；主云图默认全宽。",
      "个股详情与列表按需打开弹窗；手机保留主要复盘模块。"
    ],
    "rules": [
      {
        "name": "The Separate Signals Rule",
        "body": "钴蓝表达界面所指，红绿黑表达市场涨跌；选中状态不改写行情本色。",
        "section": "colors"
      },
      {
        "name": "The Natural Type Rule",
        "body": "先测量完整文字，再决定显示完整名、至少两字的名称前缀或省略；树图不用 maxWidth 横向挤压文字，也不描边补救。",
        "section": "typography"
      },
      {
        "name": "The Area Rule",
        "body": "总市值决定面积；筛选保留原空间权重，行业聚焦明确改变当前范围。",
        "section": "layout"
      }
    ],
    "dos": [
      "Do 使用真实行业层级与总市值面积，并保持正常字形。",
      "Do 保留行情三色、绿块深字、红黑块白字和独立选中轮廓。",
      "Do 区分12px正文、11px操作标签与图内标注的不同阅读职责。",
      "Do 为行业聚焦保留返回路径，为详情与列表弹窗保留关闭操作。",
      "Do 在手机保留五组情绪、观察列表、时间轴、走势及静态样本说明。"
    ],
    "donts": [
      "Don't 恢复900只抽样配额或将部分股票重新铺满以冒充全行业市值。",
      "Don't 用横向压缩、描边或极小字号塞满每一个股票块。",
      "Don't 用常驻侧栏或装饰性留白挤占主云图。",
      "Don't 为常驻面板添加投影、渐变或悬停抬升。",
      "Don't 把静态样本、情绪演示或仅一只K线包装成实时能力。"
    ]
  }
}
