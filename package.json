{
  "name": "guanchao-kanpan",
  "version": "1.4.1",
  "private": true,
  "description": "观潮看盘：可运行Web、数据API与跨端共享源码",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/build.cjs && node scripts/build-web.cjs",
    "check": "node scripts/check.cjs",
    "example:client": "node examples/clients/fetch-client.cjs",
    "vendor": "node scripts/vendor.cjs",
    "test": "node --test",
    "test:server": "node --test tests/server.test.cjs",
    "test:ui": "node --test tests/app.behavior.test.cjs",
    "dev:web": "node scripts/build-web.cjs",
    "test:workbench": "node --test tests/workbench.test.cjs"
  },
  "devDependencies": {
    "d3-hierarchy": "3.1.2",
    "esbuild": "0.28.2",
    "playwright": "1.62.1"
  },
  "dependencies": {
    "@ant-design/icons": "6.3.4",
    "antd": "6.7.0",
    "echarts": "6.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
